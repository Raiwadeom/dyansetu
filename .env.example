# DnyanSetu — configuration
#
# Copy to .env.local and fill in. Restart the dev server afterwards; Vite only
# reads env files at startup.
#
# Two groups, and the difference matters:
#
#   VITE_*   are compiled into the browser bundle. They are public by design —
#            a Firebase web config and a Cloudinary cloud name are meant to be
#            visible. What protects your data is firestore.rules and the signed
#            upload endpoint, not secrecy.
#
#   the rest never leave the server. Vite refuses to expose an unprefixed
#            variable to client code, which is exactly why the Cloudinary
#            secret lives here without a prefix.
#
# Never add a VITE_ prefix to anything in the second group.

# ===================== Public — safe in the browser =====================

# Firebase console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary dashboard -> the "Cloud name" shown at the top
VITE_CLOUDINARY_CLOUD_NAME=

# ================== Server only — never sent to a browser ==================

# Same value as VITE_FIREBASE_PROJECT_ID. Used to verify ID tokens.
FIREBASE_PROJECT_ID=

# Cloudinary dashboard -> Settings -> API Keys
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Settings -> Upload -> Upload presets. Must be set to SIGNED mode.
CLOUDINARY_UPLOAD_PRESET=dnyansetu_signed
