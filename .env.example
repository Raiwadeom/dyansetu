# DnyanSetu — configuration
#
# Copy to .env.local and fill in. Restart the dev server afterwards; Vite only
# reads env files at startup. On Vercel, add the same names under Project ->
# Settings -> Environment Variables. Full walkthrough: SUPABASE-SETUP.md.
#
# Two groups, and the difference matters:
#
#   VITE_*   are compiled into the browser bundle. They are public by design —
#            a Supabase anon key, a Cloudinary cloud name and a VAPID public
#            key are meant to be visible. What protects your data is Row Level
#            Security (supabase/migrations) and the server endpoints in api/,
#            not secrecy.
#
#   the rest never leave the server. Vite refuses to expose an unprefixed
#            variable to client code, which is exactly why every secret lives
#            here without a prefix.
#
# Never add a VITE_ prefix to anything in the second group.

# ===================== Public — safe in the browser =====================

# Supabase dashboard -> Project Settings -> API -> Project URL / anon public key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Cloudinary dashboard -> the "Cloud name" shown at the top
VITE_CLOUDINARY_CLOUD_NAME=

# RaktSetu web push. Same value as VAPID_PUBLIC_KEY below.
VITE_VAPID_PUBLIC_KEY=

# ================== Server only — never sent to a browser ==================

# Same URL as VITE_SUPABASE_URL. The service-role key bypasses Row Level
# Security — server functions only. Project Settings -> API -> service_role.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary dashboard -> Settings -> API Keys
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Settings -> Upload -> Upload presets. Must be set to SIGNED mode.
CLOUDINARY_UPLOAD_PRESET=dnyansetu_signed

# RaktSetu email alerts. Resend dashboard -> API Keys. The from-address must be
# on a domain verified in Resend (dnyansetu.online, DNS records in Vercel).
RESEND_API_KEY=
RESEND_FROM=RaktSetu <alerts@dnyansetu.online>
# Stop before Resend's free-tier caps (100/day, 3,000/month), leaving room for
# password-reset emails if Resend is also Supabase's SMTP.
RESEND_DAILY_LIMIT=90
RESEND_MONTHLY_LIMIT=2900

# RaktSetu web push. Generate once with:  npx web-push generate-vapid-keys
# The public key also goes in VITE_VAPID_PUBLIC_KEY above.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:smuiqac@gmail.com

# Signs the one-click unsubscribe links in alert emails. Any long random
# string, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RAKTSETU_UNSUBSCRIBE_SECRET=

# Vercel Cron sends this as a Bearer token to /api/cron/daily (keeps the free
# Supabase project awake and expires old requests). Any long random string.
CRON_SECRET=

# Links in alert emails. Optional — defaults to the address the request came in on.
PUBLIC_SITE_URL=https://www.dnyansetu.online

# ------------- Firebase (only for moving existing accounts over) -------------

# The old Firebase web API key (same value as the old VITE_FIREBASE_API_KEY).
# api/legacy-login.js uses it to check a migrated user's old password on their
# first sign-in. Keep it set until every old account has signed in once.
FIREBASE_API_KEY=
